# Copy to .env and fill in. .env is gitignored.

# Foundry resource endpoint (Overview page in the Azure portal)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini

# Leave unset to use Entra ID (az login). Only set if you must use keys.
# AZURE_OPENAI_API_KEY=

DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
